<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE: en Android 12+ basta con los permisos nuevos; ACCESS_FINE_LOCATION
         solo se pide en versiones anteriores, donde el escaneo lo exigia. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Localizacion: ya no solo para el escaneo BLE antiguo. Desde que la descarga
         registra la posicion en los metadatos hace falta en cualquier version, asi que el
         tope de maxSdkVersion desaparece. El neverForLocation de BLUETOOTH_SCAN se queda:
         sigue siendo cierto que el escaneo no se usa para deducir posicion. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notas de audio de la libreta. Se pide al pulsar grabar, no al arrancar. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- El cronometro de una medicion GNSS: dura horas con la pantalla apagada, asi que la
         cuenta atras y su alarma viven en un servicio en primer plano y no en la app.

         SI hacen falta los permisos de alarma exacta, al contrario de lo que decia este
         comentario antes: `setAlarmClock` lanza SecurityException sin ellos ("Caller needs to
         hold SCHEDULE_EXACT_ALARM or USE_EXACT_ALARM"), comprobado en el aparato. Esa es la
         razon de que la alarma no sonara.

         USE_EXACT_ALARM (API 33+) se concede al INSTALAR y no se puede revocar: esta pensado
         justo para apps cuya funcion es avisar a una hora, que es literalmente lo que hace
         esto. En 31 y 32 no existe todavia, y ahi vale SCHEDULE_EXACT_ALARM, que en esas dos
         versiones se concede solo. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:label="GlacioTools"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlacioTools">
        <!-- adjustResize: sin esto Android DESPLAZA la ventana para descubrir el campo
             enfocado, y la cabecera y las pestanas se salen por arriba. Al redimensionar,
             el terminal cede el espacio que haga falta, porque lleva weight(1f). -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Al enchufar un cable serie, Android pregunta que app abrir y GlacioTools
                 tiene que estar en esa lista. Elegirla ahi hace ademas algo que no se ve:
                 CONCEDE el permiso USB para ese aparato, con lo que desaparece el paso de
                 autorizar el adaptador a mano antes de poder conectar. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <!-- La lista de aparatos la GENERA tools/gen_usb_device_filter.py a partir de
                 los drivers de usb-serial-for-android. Escrita a mano se desfasa en
                 silencio: la app se ofreceria para un chip que no sabe abrir, o no se
                 ofreceria para uno que si. -->
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
        <!-- La camara escribe en un fichero de la app, y desde Android 7 no se le puede
             pasar una file://, porque el sistema lanza FileUriExposedException. El provider
             le entrega una content:// con permiso solo para ese fichero. La autoridad la
             construye MediaVault a partir del packageName; tienen que coincidir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- specialUse: no encaja en ninguno de los tipos que Android enumera (no es
             reproduccion, ni sincronizacion, ni localizacion: es un cronometro de una tarea
             que el usuario inicio y que tiene que avisar aunque el telefono duerma). -->
        <service
            android:name=".app.GnssTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Timing a field GNSS occupation and alerting when the planned duration elapses" />
        </service>
    </application>
</manifest>

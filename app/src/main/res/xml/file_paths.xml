<?xml version="1.0" encoding="utf-8"?>
<!--
    Lo unico que el FileProvider deja salir: la carpeta de medios de la libreta.

    Acotado a `fieldbook/media` y no a la carpeta privada entera. La URI que se le entrega a
    la camara da permiso de escritura sobre lo que este dentro del camino declarado, y ahi
    tambien viven los puntos de GPS y las preferencias.
-->
<paths>
    <files-path name="fieldbook-media" path="fieldbook/media/" />
</paths>
